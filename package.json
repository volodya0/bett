{
  "name": "kumbet",
  "version": "1.0.0",
  "description": "Тоталізатор для друзів: прогнози на футбол за умовні бали",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --test server/scoring.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "vite": "^6.4.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
